# Salin file ini ke .env lalu isi nilainya. .env tidak pernah masuk git.
# Kosongkan variabel yang tidak dipakai. Nilai kosong dianggap tidak ada.

# paper (default) | testnet | live
TRADING_MODE=

# Kunci Binance Spot Testnet, dibuat di https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Kunci Tokocrypto (venue live, uang asli). Buat TANPA izin withdrawal; kalau halaman
# API Management menyediakan pembatasan IP, aktifkan. Tokocrypto tidak punya testnet.
TOKOCRYPTO_API_KEY=
TOKOCRYPTO_API_SECRET=

# Hanya dipakai kalau exchange.live.id di config diganti ke binance (bukan target project ini).
BINANCE_API_KEY=
BINANCE_API_SECRET=
