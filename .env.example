# Salin file ini ke .env lalu isi nilainya. .env tidak pernah masuk git.
# Kosongkan variabel yang tidak dipakai. Nilai kosong dianggap tidak ada.

# paper (default) | testnet | live
TRADING_MODE=

# Kunci Binance Spot Testnet, dibuat di https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Kunci Binance Spot mainnet. Buat TANPA izin withdrawal dan DENGAN IP whitelist.
BINANCE_API_KEY=
BINANCE_API_SECRET=
